# Verified backups of the runtime, economy, business and tools databases.
# Runs as root so backups sit outside the agent's and services' write access
# (WIDEMIND_BACKUP_DIR, for example /var/backups/widemind, owned by root, 0700).
# It must be able to read every database and its -wal/-shm companions.
[Unit]
Description=WideMind database backup

[Service]
Type=oneshot
WorkingDirectory=/opt/widemind
ExecStart=/usr/bin/node --env-file=/opt/widemind/.env /opt/widemind/dist/runtime/backup-main.js run
ExecStartPost=/usr/bin/node --env-file=/opt/widemind/.env /opt/widemind/dist/runtime/backup-main.js verify
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
