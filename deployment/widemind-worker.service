[Unit]
Description=WideMind persistent agent worker
After=network.target

[Service]
Type=simple
User=widemind
Group=widemind
WorkingDirectory=/opt/widemind
ExecStart=/usr/bin/node --env-file=/opt/widemind/.env /opt/widemind/dist/runtime/main.js
Restart=always
RestartSec=3
TimeoutStopSec=330
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/widemind

[Install]
WantedBy=multi-user.target
