# /opt/widemind/.env — owner widemind, mode 0600. Placeholders only; never commit real values.
# The economy service keeps its own /etc/widemind/economy.env (see deploy/).

# Website and runtime
WIDEMIND_PROFILE=foundation
WIDEMIND_HOST=127.0.0.1
WIDEMIND_PORT=3000
WIDEMIND_PUBLIC_ORIGIN=https://widemind.example.com
WIDEMIND_SECURE_COOKIES=true
WIDEMIND_DATABASE=/var/lib/widemind/widemind.sqlite
WIDEMIND_OPERATOR_PASSWORD_HASH=<output of npm run operator:hash>
WIDEMIND_COMMERCE_RUN_ID=<run id created by the operator>

# Live effects stay off until preflight passes everything else.
WIDEMIND_ENABLE_LIVE_EFFECTS=false
WIDEMIND_COMMERCE_MODE=sandbox
WIDEMIND_BUSINESS_MODE=test

# Loopback services and their distinct tokens (openssl rand -hex 32 each)
WIDEMIND_ECONOMY_URL=http://127.0.0.1:8080
WIDEMIND_TOOLS_URL=http://127.0.0.1:8081
WIDEMIND_BUSINESS_URL=http://127.0.0.1:8082
WIDEMIND_ECONOMY_OPERATOR_TOKEN=<random>
WIDEMIND_ECONOMY_GATEWAY_TOKEN=<random>
WIDEMIND_ECONOMY_AGENT_TOKEN=<random>
WIDEMIND_TOOLS_TOKEN=<random>
WIDEMIND_BUSINESS_TOKEN=<random>

# Service data (also used as backup sources)
WIDEMIND_ECONOMY_DB=/var/lib/widemind-economy/economy.sqlite3
WIDEMIND_BUSINESS_DB=/var/lib/widemind/business.sqlite
WIDEMIND_TOOLS_STATE=/var/lib/widemind/tools/control
WIDEMIND_TOOLS_WORKSPACE=/var/lib/widemind/tools/workspace

# Payments (PayPal is the selected provider)
WIDEMIND_PAYMENT_PROVIDER=paypal
WIDEMIND_PAYPAL_MODE=sandbox
WIDEMIND_PAYPAL_CLIENT_ID=<from PayPal developer dashboard>
WIDEMIND_PAYPAL_CLIENT_SECRET=<from PayPal developer dashboard>
WIDEMIND_PAYPAL_MERCHANT_ID=<merchant id>
WIDEMIND_PAYPAL_WEBHOOK_ID=<webhook id for https://widemind.example.com/api/modules/economy/webhook>
WIDEMIND_CHECKOUT_SUCCESS_URL=https://widemind.example.com/commerce
WIDEMIND_CHECKOUT_CANCEL_URL=https://widemind.example.com/commerce

# Dedicated accounts (see docs/GMAIL.md and docs/AI-PROVIDERS.md)
WIDEMIND_GMAIL_ADDRESS=<dedicated mailbox>
OPENAI_API_KEY=<key>
OPENAI_MODEL=<model>

# Pilot operations
WIDEMIND_ALERT_WEBHOOK_URL=<https incoming webhook>
WIDEMIND_ALERT_REPEAT_MINUTES=360
WIDEMIND_BACKUP_DIR=/var/backups/widemind
WIDEMIND_BACKUP_KEEP=28
WIDEMIND_BACKUP_MAX_AGE_HOURS=8
