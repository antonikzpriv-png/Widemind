# This file contains names and nonsecret examples only. Load actual credentials
# through deployment secrets; WideMind does not automatically load a .env file.
# provider-test uses real Gmail/OpenAI APIs and can incur actual model charges.
WIDEMIND_MODE=test
WIDEMIND_RUN_ID=provider-test-001
WIDEMIND_HOST_FACTORY=widemind.host:business_factory
WIDEMIND_BUSINESS_DB=/var/lib/widemind/business/business.sqlite3
WIDEMIND_RUNTIME_DB=/var/lib/widemind/control/runtime.sqlite3
WIDEMIND_ECONOMY_DB=/var/lib/widemind/control/economy.sqlite3
WIDEMIND_TOOLS_DB=/var/lib/widemind/control/tools.sqlite3
WIDEMIND_WORKSPACE=/var/lib/widemind/workspace
WIDEMIND_CREDENTIALS_DIR=/var/lib/widemind/credentials
# Restrict qualification to a mailbox controlled by the operator.
WIDEMIND_GMAIL_ADDRESS=
WIDEMIND_ALLOWED_RECIPIENTS='["controlled-recipient@example.invalid"]'
WIDEMIND_OPERATOR_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Explicit example price configuration, not a claim about current provider rates.
# Verify the actual model's rates before authorizing a run.
OPENAI_INPUT_MICRO_USD_PER_MILLION_TOKENS=400000
OPENAI_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=1600000
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_MAX_INPUT_BYTES=24000
# Configured fallback sources; individual agreed scopes may provide other URLs.
WIDEMIND_RESEARCH_SOURCE_URLS='["https://docs.python.org/3/library/sqlite3.html","https://www.sqlite.org/lang_transaction.html"]'
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-configured-domain.example/payment/success
STRIPE_CANCEL_URL=https://your-configured-domain.example/payment/cancel
