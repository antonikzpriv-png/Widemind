# npm commands load .env if present. Existing environment variables take precedence.
WIDEMIND_DATABASE=./var/widemind.sqlite
WIDEMIND_HOST=127.0.0.1
WIDEMIND_PORT=3000
WIDEMIND_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Generate with npm run operator:hash; paste only its scrypt hash here.
WIDEMIND_OPERATOR_PASSWORD_HASH=
# foundation: missing providers are unavailable; demo: explicit zero-cost local task.
WIDEMIND_PROFILE=foundation
WIDEMIND_SECURE_COOKIES=false
WIDEMIND_LEASE_MS=30000
WIDEMIND_IDLE_MS=60000
