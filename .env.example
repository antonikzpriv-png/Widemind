# npm commands load .env if present. Existing environment variables take precedence.
WIDEMIND_DATABASE=./var/widemind.sqlite
WIDEMIND_HOST=127.0.0.1
WIDEMIND_PORT=3000
WIDEMIND_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Generate with npm run operator:hash; paste only its scrypt hash here.
WIDEMIND_OPERATOR_PASSWORD_HASH=
# foundation: missing providers are unavailable; demo: explicit zero-cost local task.
WIDEMIND_PROFILE=foundation
WIDEMIND_SECURE_COOKIES=false
WIDEMIND_LEASE_MS=30000
WIDEMIND_IDLE_MS=60000

# Maximum wait for a free module/control-plane call. Timed-out effects are reconciled.
WIDEMIND_DEPENDENCY_MS=5000

# Economy control plane (run separately from the agent worker)
# Example only. Generate three DIFFERENT tokens with secrets.token_urlsafe(48).
# Never supply operator or gateway credentials to the agent.
WIDEMIND_ECONOMY_DB=data/economy.sqlite3
WIDEMIND_OPERATOR_TOKEN=
WIDEMIND_GATEWAY_TOKEN=
WIDEMIND_AGENT_TOKEN=
WIDEMIND_AGENT_RUN_ID=sandbox-run-1

# Optional: leave ALL Stripe settings empty to use accounting without payments.
# Test and live use separate databases, runs, keys and webhook endpoints.
WIDEMIND_STRIPE_MODE=test
WIDEMIND_STRIPE_ACCOUNT=
WIDEMIND_STRIPE_API_KEY=
WIDEMIND_STRIPE_WEBHOOK_SECRET=
WIDEMIND_CHECKOUT_SUCCESS_URL=
WIDEMIND_CHECKOUT_CANCEL_URL=

# Optional Node-to-Python economy bridge. Leave URL blank to keep default unavailable/demo behavior.
WIDEMIND_ECONOMY_URL=
WIDEMIND_ECONOMY_TIMEOUT_MS=4000
# Keep this private, stable authorization-signing key distinct from all role bearer tokens.
WIDEMIND_RUNTIME_AUTH_SECRET=
# Operator-owned object mapping registered tool IDs to provider/account/mode; never model input.
# Example shape only: {"local.note":{"provider":"local","account":"dedicated-workspace","mode":"sandbox"}}
WIDEMIND_RUNTIME_TOOL_PROFILES=

# Optional business module. Enable on BOTH web and worker; it uses the existing foundation runtime.
WIDEMIND_BUSINESS_ENABLED=false
# Explicit central commerce identity/mode; matches the economy's commerce tool profiles.
WIDEMIND_COMMERCE_ACCOUNT=
WIDEMIND_COMMERCE_MODE=

# Real Gmail/OpenAI bridge. Empty profile leaves it disabled; provider-test can still incur real API costs.
WIDEMIND_BUSINESS_TOOLS_PROFILE=
WIDEMIND_BUSINESS_PYTHON=python3
# Absolute protected path distinct from runtime/economy DBs and outside the agent workspace.
WIDEMIND_BUSINESS_TOOLS_JOURNAL=
WIDEMIND_BUSINESS_WORKSPACE=
WIDEMIND_BUSINESS_ALLOWED_RECIPIENTS=[]
WIDEMIND_BUSINESS_GMAIL_ACCOUNT=
WIDEMIND_GMAIL_ADDRESS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
WIDEMIND_BUSINESS_OPENAI_ACCOUNT=
OPENAI_API_KEY=
OPENAI_MODEL=
# Operator-verified exact micro-USD per MILLION tokens. No guessed model prices.
OPENAI_INPUT_MICRO_USD_PER_MILLION_TOKENS=
OPENAI_CACHED_INPUT_MICRO_USD_PER_MILLION_TOKENS=
OPENAI_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_MAX_INPUT_BYTES=24000
WIDEMIND_RESEARCH_SOURCE_URLS=[]
WIDEMIND_RESEARCH_ALLOWED_HOSTS=[]
# Set true only after verifying that the inherited proxy enforces public destinations at connect time.
WIDEMIND_BUSINESS_PUBLIC_PROXY_GUARDED=false
WIDEMIND_BUSINESS_GMAIL_DAILY_LIMIT=500
WIDEMIND_BUSINESS_RESEARCH_DAILY_LIMIT=50
