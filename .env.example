# Example only. Generate three DIFFERENT tokens with secrets.token_urlsafe(48).
# Never supply operator or gateway credentials to the agent.
WIDEMIND_ECONOMY_DB=data/economy.sqlite3
WIDEMIND_OPERATOR_TOKEN=
WIDEMIND_GATEWAY_TOKEN=
WIDEMIND_AGENT_TOKEN=
WIDEMIND_AGENT_RUN_ID=sandbox-run-1

# Optional: leave ALL Stripe settings empty to use accounting without payments.
# Test and live use separate databases, runs, keys and webhook endpoints.
WIDEMIND_STRIPE_MODE=test
WIDEMIND_STRIPE_ACCOUNT=
WIDEMIND_STRIPE_API_KEY=
WIDEMIND_STRIPE_WEBHOOK_SECRET=
WIDEMIND_CHECKOUT_SUCCESS_URL=
WIDEMIND_CHECKOUT_CANCEL_URL=
