{
  "name": "widemind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env --watch src/web/main.ts",
    "worker:dev": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env --watch src/runtime/main.ts",
    "migrate": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/db/migrate-main.ts",
    "operator:hash": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/auth/hash-main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env dist/web/main.js",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env dist/runtime/main.js",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src test scripts *.json",
    "format:check": "prettier --check src test scripts *.json",
    "smoke": "node scripts/smoke.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "status": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/status-main.ts",
    "services:configure": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env scripts/services.mjs configure",
    "services:setup": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env scripts/services.mjs setup",
    "services:start": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env scripts/services.mjs start",
    "services:status": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env scripts/services.mjs status",
    "dev:all": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env scripts/services.mjs all",
    "pilot:init": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env scripts/pilot-init.mjs",
    "pilot:preflight": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/pilot-preflight-main.ts",
    "pilot:report": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/pilot-report-main.ts",
    "pilot:attest": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/pilot-attest-main.ts",
    "pilot:cost": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/pilot-cost-main.ts",
    "pilot:alerts": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/pilot-alerts-main.ts",
    "pilot:snapshot": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/pilot-snapshot-main.ts",
    "pilot:rehearse": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/rehearse-main.ts",
    "backup": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/backup-main.ts run",
    "backup:verify": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/backup-main.ts verify",
    "backup:restore": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/backup-main.ts restore",
    "backup:offsite": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env src/runtime/backup-main.ts offsite",
    "backup:keygen": "node src/runtime/backup-main.ts keygen",
    "backup:decrypt": "node src/runtime/backup-main.ts decrypt",
    "integration:smoke": "node scripts/integration-smoke.mjs",
    "integration:browser": "node scripts/integration-smoke.mjs --browser",
    "services:test": "node --env-file-if-exists=.env --env-file-if-exists=var/integration.env scripts/services.mjs test",
    "business:sync-inbox": "node --env-file-if-exists=.env src/modules/brief-business/sync-main.ts",
    "business:demo": "node scripts/business-demo.mjs",
    "business:browser": "node scripts/business-browser-smoke.mjs",
    "discovery:demo": "node scripts/discovery-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
