{
  "name": "widemind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/web/main.ts",
    "worker:dev": "node --env-file-if-exists=.env --watch src/runtime/main.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate-main.ts",
    "operator:hash": "node --env-file-if-exists=.env src/auth/hash-main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/web/main.js",
    "worker": "node --env-file-if-exists=.env dist/runtime/main.js",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src test scripts *.json",
    "format:check": "prettier --check src test scripts *.json",
    "smoke": "node scripts/smoke.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
